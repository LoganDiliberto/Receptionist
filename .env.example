# Copy to .env and fill in your keys.

# OpenAI (LLM).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Deepgram (speech-to-text). Sign up at https://console.deepgram.com and
# grab an API key. First $200 of usage is free; after that ~$0.0043/min
# on nova-3.
DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-3-general

# Piper (text-to-speech, local, CPU).
PIPER_VOICE=en_US-amy-medium

# Server. On Fly.io / any container host, set HOST=0.0.0.0 so uvicorn
# binds every interface (the container network's, not just loopback).
HOST=127.0.0.1
PORT=7860

# Path to the salon Excel workbook (legacy import only).
# - Local dev:      keep the default (workbook next to salon.py in the repo).
# - Fly.io / prod:  set to /data/ReceptionistData.xlsx so it lives on the
#                   persistent volume and survives redeploys.
# SALON_DATA_PATH=/data/ReceptionistData.xlsx

# SQLite path. Defaults to ./receptionist.db next to the app.
# Fly.io sets this to /data/receptionist.db via fly.toml.
# SALON_DB_PATH=/data/receptionist.db

# Twilio — required for the /voice + /twilio/ws phone path, and for
# outbound appointment SMS reminders.
# Find these at https://console.twilio.com (Account Info card).
# Auth token is sensitive — never commit .env.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The salon phone number in E.164. Same number that receives voice calls.
# Used as the From: on reminder SMS.
TWILIO_FROM_NUMBER=+12035551234

# Salon local timezone for interpreting appointment date/time when
# scheduling the ~24h reminder. Stamford CT = America/New_York.
# SALON_TZ=America/New_York

# How often the in-process reminder poller checks for due SMS (seconds).
# REMINDER_POLL_SECONDS=300

# Admin UI + /api Basic Auth. When ADMIN_PASSWORD is set, browsers get a
# native login prompt for /admin and /api. Leave unset for open local
# development. Required in production (set as a Fly secret).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
