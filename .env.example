# Copy to .env and fill in your keys
OPENAI_API_KEY=sk-...

# Optional: model overrides
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=small.en
PIPER_VOICE=en_US-amy-medium

# Server. Use 0.0.0.0 when fronted by ngrok so it accepts the forwarded request.
HOST=127.0.0.1
PORT=7860

# Path to the salon Excel workbook. Static info (hours, stylists, schedules) is
# read once at startup; the bot adds an "Appointments" sheet here for bookings.
SALON_DATA_PATH=C:\Users\logan\Downloads\Receptionist data.xlsx

# Twilio — required for the /voice + /twilio/ws phone path.
# Find these at https://console.twilio.com (Account Info card).
# Auth token is sensitive — never commit .env.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
